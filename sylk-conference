"""Join a SylkServer conference room over WebRTC with audio and chat, and publish
local or RTSP cameras in it, without a SIP stack: a pure SylkServer client.

Its own folder is ~/.sylkclient/. Its config file (the SIP SIMPLE configuration
format, managed with sylk-settings) holds:

    SylkSettings    general settings: audio devices, muted, TLS verification, default session
    Sessions        what a room is joined with: room, account, cameras, overrides of the general settings
    RTSPCameras     RTSP cameras, usable by any session
    LocalCameras    V4L2 devices or test patterns, usable by any session
    Accounts        accounts of its own

Accounts are searched in ~/.sylkclient, then in the SIP SIMPLE clients' ~/.sipclient
and Blink's ~/.blink (read only, for credentials): the one named with -a or by the
session, else the default account of the first that has one.

    sylk-conference                    the default session
    sylk-conference garden             the session named garden (or whose room is garden)
    sylk-conference myroom@example.com a room without a session: general settings, no cameras
    sylk-conference --headless --record-audio myroom
                                       listen only (no microphone, speakers or camera) and record the room

Recordings (--record-audio) go to ~/.sylkclient/recordings/<room's SIP URI>/<YYYYmmdd-HHMMSS>.ogg (Opus), a
file each time the room is joined; --record-tracks also (or only) a FLAC per participant in
<YYYYmmdd-HHMMSS>-tracks/<name>.flac, each starting at the same moment (silence until they came: laid side by
side in a DAW, they line up). While recording, we are in the room as "● Recording", so everyone knows; with
--headless we send nothing (our audio offered inactive; muted silence when the server does not take that).
Where the files are is shown when it ends.

Typed lines are sent to the room's chat; /help lists the commands. For a call
to someone (1 to 1), see sylk-session.
"""

import argparse
import logging
import os
import sys
import time

from application.notification import IObserver, NotificationCenter
from application.python import Null
from twisted.internet import reactor, stdio
from twisted.internet.task import deferLater
from zope.interface import implementer

from sylkrtc import sipconfig
from sylkrtc.cli import (mute_log_lines, network_lines, network_text, with_sidebar, BOLD, DIM, GAP, RED, RESET, SCALE, AudioChoice, Console, MixerControl, Statistics, StatusPanel, addresses,
                         human_bytes, human_rate, meter_panel, report_discovery, report_server_info, select_cameras,
                         setup_logging, start_log_file, take_room_from_cameras, vu_meters)
from sylkrtc.discovery import Discovery
from sylkrtc.rooms import RoomTarget, parse_room, configuration_domain
from sylkrtc.videoroom import Identity, VideoroomSession, MAX_EXTRA_VIDEOS


log = logging.getLogger('sylk-conference')

from sylkrtc.device import USER_AGENT     # one device for all the tools (sylkrtc.device)
RETRY_DELAYS = [5, 10, 20, 40, 60]      # s between attempts to join again / to restart a camera
RECORDINGS = '~/.sylkclient/recordings'
RECORDING_NAME = '\u25cf Recording'
RECORD_BITRATE = 128000                 # bit/s: the room's mix, music as well as voices


def parse_arguments():
    parser = argparse.ArgumentParser(description='Join a SylkServer conference room with audio and chat over WebRTC and publish cameras in it.')
    parser.add_argument('room', nargs='?', help='a session (sylk-settings --session), or a room: a name (on the account\'s domain), room@domain or a link; '
                                                 'default: the default session')
    parser.add_argument('-d', '--config-dir', help='the folder whose config file holds the account (default: ~/.sylkclient/, else the credentials '
                                                     'of the SIP SIMPLE clients\' ~/.sipclient/ or of Blink\'s ~/.blink/)')
    parser.add_argument('-a', '--account', help='the account to use (default: the default account)')
    parser.add_argument('-r', '--rtsp-camera', action='append', nargs='?', const='all', default=[], metavar='CAMERA',
                        help='publish an RTSP camera too (repeatable): without a value or all, every enabled one configured; a configured one by name or id (MAC), '
                             'or LABEL=rtsp://... (credentials in it), optionally followed by ,transcode=auto|yes|no ,resolution=640x360 ,fps=10')
    parser.add_argument('-c', '--local-camera', action='append', nargs='?', const='all', default=[], metavar='CAMERA',
                        help='the local cameras (repeatable); by default the one attached: an external (USB) camera when plugged in, '
                             'else the built-in one; without a value or all, every camera attached; none (false, 0): no local camera; '
                             'a configured one by name or id, or LABEL=/dev/videoN or LABEL=test[:pattern], optionally followed by '
                             ',resolution=640x360 ,fps=10. The first local camera is our own video, the others are shown under it')
    parser.add_argument('--no-video', action='store_true', help='join with audio (and chat) only: no camera of ours, no RTSP cameras, '
                                                                    'whatever the session or the general settings have')
    parser.add_argument('-i', '--invite', action='append', default=[], metavar='USER',
                        help='invite someone once in the room (repeatable, or comma separated): user@domain, or user at the account\'s domain')
    parser.add_argument('--audio-input', help='auto, none or a GStreamer source description')
    parser.add_argument('--audio-output', help='auto, none or a GStreamer sink description')
    parser.add_argument('--muted', action='store_true', default=None, help='start with the microphone muted')
    parser.add_argument('--headless', action='store_true',
                        help='no microphone, no speakers and no camera (unless -c or -r asks for one): only listen, e.g. to record')
    parser.add_argument('--record-tracks', nargs='?', const=RECORDINGS, default=None, metavar='FOLDER',
                        help='while recording (--record-audio, or r): each participant and our own side (what we send) on a track '
                             'of its own too, FLAC, into FOLDER/<room\'s SIP URI>/<time>-tracks/ (aligned: each starts at the same moment)')
    parser.add_argument('--record-audio', nargs='?', const=RECORDINGS, default=None, metavar='FOLDER',
                        help=f'record the whole mix, what we hear and what we send (microphone, music), from joining, as Ogg Opus '
                             f'into FOLDER/<room\'s SIP URI>/<time>.ogg (default folder: {RECORDINGS}); r stops it, and starts a new file')
    parser.add_argument('--device-level', type=int, choices=range(10), default=None, metavar='0-9',
                        help='our audio input device\'s (microphone\'s) level at first, as the keys set it: 0 muted, 1 to 9 '
                             'from -40 dB (barely heard) to 0 dB, 5 dB a step (default 0 dB, 9)')
    parser.add_argument('--playback-random', action='store_true',
                        help='start the music at a random file of those given (a folder: any of its files), then on in order; '
                             'each time we connect')
    parser.add_argument('--playback-level', type=int, choices=range(10), default=None, metavar='0-9',
                        help='the music\'s level at first, as the keys set it: 0 muted, 1 to 9 from -40 dB (barely heard) to 0 dB, 5 dB a step (default -6 dB)')
    parser.add_argument('--total-out-level', action='store_true', help='with --playback: the total of what we send in the mixer too '
                                                                       '(its level and a volume for all of it)')
    parser.add_argument('--monitor', action='store_true', help='hear what we send in our headphones too, from the start: each of ours (the microphone, '
                                                               'the music) on or off with a or space when selected in the mixer (with --playback alone: off at first)')
    parser.add_argument('--playback', action='append', default=[], metavar='PATH',
                        help='mix music into what we send (repeatable): audio files, or folders of them, played in order and again; '
                             'with it the terminal takes single keys and the panel is a mixer: left and right arrows select the '
                             'microphone or the music, up and down set its gain; Enter (or t) types a chat message, / a command '
                             '(in stereo with --stereo)')
    parser.add_argument('--stereo', action='store_true', help='stereo audio: a stereo microphone (or the source of --audio-input) and Opus in stereo, no echo canceller; a room made by joining it becomes a stereo room (one that exists keeps its own audio: mono participants hear and send mono)')
    parser.add_argument('--discover', action='store_true', help='only look up the SylkServer configuration of the account\'s domain (and of the room\'s, when given), cache it and show it')
    parser.add_argument('--server-info', action='store_true', help='connect to the SylkServer of the account (or of the room, when given) and report its version, '
                                                                  'what it supports and whether it takes the account')
    parser.add_argument('--stats-interval', type=float, default=60, metavar='SECONDS',
                        help='log the bandwidth, round trip time and loss of every stream this often (default %(default)g, 0: never); a summary is logged on leaving')
    parser.add_argument('--auto-disconnect', type=float, default=None, metavar='SECONDS',
                        help='leave the room and exit this many seconds after first getting in (default 600, 10 minutes; '
                             'with --record-audio 0; 0: stay)')
    parser.add_argument('--no-retry', action='store_true', help='exit when the room is left instead of joining again')
    parser.add_argument('--auto-reconnect', action='store_true',
                        help=f'stay: join the room again {RETRY_DELAYS[0]:g} s after the connection to it breaks, every time (no longer '
                             'waits between attempts), and do not leave by itself (--auto-disconnect 0 unless given)')
    parser.add_argument('-j', '--jitter', action='store_true', help='show the jitter in the status panel too')
    parser.add_argument('--jitter-buffer', type=int, default=None, metavar='MS',
                        help='how long the jitter buffer waits for packets (default 200 ms): more for a network that delivers in bursts '
                             '(gaps heard, late packets in the panel, but no loss), at the cost of as much delay')
    parser.add_argument('--no-logs', action='store_true',
                        help='the panel takes the terminal, but for the last lines (messages, what is typed): the log lines go to the log '
                             'file only (~/.sylkclient/logs/), to follow with tail -f in another terminal')
    parser.add_argument('--no-panel', action='store_true', help='no status panel at the top of the terminal (a level meter per '
                                                                'participant, loss, round trip time), only the scrolling console')
    parser.add_argument('--no-input', action='store_true', help='do not read chat messages and commands from the terminal')
    parser.add_argument('-v', '--verbose', '--debug', dest='debug', action='store_true', help='log debug messages')
    parser.add_argument('--sdp', action='store_true', help='log the SDP offers and answers exchanged')
    parser.add_argument('-t', '--trace', action='store_true', help='log the sylkRTC messages')
    arguments = parser.parse_args()
    if arguments.auto_reconnect and arguments.no_retry:
        raise SystemExit('--auto-reconnect and --no-retry: one or the other')
    if arguments.auto_disconnect is None:       # a recording (or --auto-reconnect) runs until it is stopped (Ctrl-C, /quit)
        arguments.auto_disconnect = 0 if arguments.record_audio or arguments.record_tracks or arguments.auto_reconnect else 600
    return arguments


@implementer(IObserver)
class SylkConference(object):
    def __init__(self, arguments):
        self.arguments = arguments
        # our own folder: the settings, sessions, cameras, the cache and possibly our own accounts;
        # another client's (~/.sipclient, ~/.blink) only for credentials
        os.makedirs(sipconfig.DEFAULT_DIRECTORY, mode=0o700, exist_ok=True)
        try:
            configuration = sipconfig.SylkConfiguration()
        except sipconfig.ConfigError as e:
            raise SystemExit(str(e))
        reporting = arguments.discover or arguments.server_info
        if arguments.room is None:
            take_room_from_cameras(arguments, configuration)
        # the session: named on the command line, the one whose room was given, else the default one; a room without one is joined as it is
        session = None
        if arguments.room:
            session = configuration.find_session(arguments.room) or configuration.session_for_room(arguments.room)
        elif configuration.default_session:
            session = configuration.find_session(configuration.default_session)
            if session is None and not reporting:
                raise SystemExit(f'the default session {configuration.default_session} does not exist (sylk-settings --session list)')
        self.configuration_session = session
        self.room_text = (session or {}).get('room') or arguments.room
        if not self.room_text and not reporting:
            raise SystemExit('which room? give a room or a session (sylk-settings --session add ..., --session default ...)')
        try:
            self.account, self.config_dir = sipconfig.locate_account(arguments.account or (session or {}).get('account'),
                                                                      os.path.expanduser(arguments.config_dir) if arguments.config_dir else None)
        except sipconfig.ConfigError as e:
            raise SystemExit(str(e))
        if not self.account.password and not reporting:
            raise SystemExit(f'{self.account.id} has no password in {os.path.join(self.config_dir, "config")}')

        def setting(name, given):
            # the command line, else the session, else the general setting
            if given is not None:
                return given
            if session is not None and session.get(name) is not None:
                return session[name]
            return getattr(configuration, name)

        self.audio_input = setting('audio_input', arguments.audio_input)
        self.audio_output = setting('audio_output', arguments.audio_output)
        self.muted = setting('muted', arguments.muted)
        if arguments.headless:      # listening only: nothing of ours, nothing played here
            self.audio_input = self.audio_output = 'none'
            self.muted = True
        self.recordings = []        # the files recorded (--record-audio), shown at the end
        self.track_paths = []       # each participant's (--record-tracks), as they come
        self._established = False   # the room got into at least once (the listen-only offer taken)
        self.stereo = arguments.stereo
        self.verify_tls = configuration.tls_verify_server
        if arguments.no_video:
            if arguments.rtsp_camera or arguments.local_camera:
                raise SystemExit('--no-video publishes no camera: leave out --rtsp-camera and --local-camera')
            self.cameras = []
        else:
            self.cameras = select_cameras(configuration, arguments.rtsp_camera, arguments.local_camera, (session or {}).get('cameras'),
                                          (session or {}).get('name'), default_local=not reporting and not arguments.headless)
        # a local camera (the first one) is our own video: the other cameras, the RTSP ones, are shown under it
        self.main_camera = next(((label, source) for label, source in self.cameras if source['kind'] in ('v4l2', 'test')), None)
        if self.main_camera is not None:
            self.cameras.remove(self.main_camera)
        if len(self.cameras) > MAX_EXTRA_VIDEOS:
            raise SystemExit(f'at most {MAX_EXTRA_VIDEOS} cameras besides our own video, {len(self.cameras)} asked for: {", ".join(label for label, source in self.cameras)}')
        self.discovery = Discovery(os.path.join(sipconfig.DEFAULT_DIRECTORY, 'sylkserver'))
        self.recording = bool(arguments.record_audio or arguments.record_tracks)
        # recording: in the room as "Recording", so everyone sees it is
        display_name = RECORDING_NAME if self.recording else self.account.display_name
        self.identity = Identity.from_credentials(self.account.id, self.account.password, display_name,
                                                  auth_username=self.account.auth_username, instance_id=self.account.instance_id)
        self.listen_only = bool(arguments.headless and self.recording)     # nothing sent, if the server takes it
        self.target = None
        self.remote = False
        self.session = None
        self.extras = {}            # label -> ExtraVideo
        self.camera_retries = {}    # label -> attempts
        self.attempt = 0
        self.stopping = False
        self.statistics = Statistics(arguments.stats_interval)
        self.mixer_control = MixerControl(hidden=() if arguments.total_out_level else [('send', 'total')])      # the console mixer
        self.console = None
        self.audio = AudioChoice(self.audio_input, self.audio_output)
        self.audio.on_switch = self._audio_switched
        self.audio.watch()          # the devices that come and go, as the system tells
        NotificationCenter().add_observer(self)

    # Start

    def start(self):
        if self.arguments.discover:
            self.discover()
            return
        if self.arguments.server_info:
            self.server_info()
            return
        from sylkrtc.gst import media_missing, media_report
        log.info(f'{USER_AGENT}, {media_report()}')
        missing = media_missing()
        if missing:
            log.error('missing: ' + ', '.join(f'{what} (install {package})' for what, package in missing))
            reactor.stop()
            return
        print('\n'.join(f'* {line}' for line in self.audio.lines()))
        log.info(f'account {self.account.id} (from {os.path.join(self.config_dir, "config")}), room {self.room_text}'
                 + (f' (session {self.configuration_session["name"]})' if self.configuration_session else '')
                 + (', audio only (--no-video)' if self.arguments.no_video else f', our video {self.main_camera[0]}' if self.main_camera else '')
                 + (f', cameras {", ".join(label for label, source in self.cameras)}' + (' (under it)' if self.main_camera else '') if self.cameras else ''))
        self.discovery.discover(self.account.domain).addCallback(self._own_configuration)

    def _report_domain(self):
        parsed = parse_room(self.room_text) if self.room_text else None
        return configuration_domain(parsed[1]) if parsed is not None and parsed[1] else None

    def discover(self):
        """--discover: the account's domain (and the room's), looked up again, cached and shown."""
        domains = [self.account.domain]
        other = self._report_domain()
        if other and other not in domains:
            domains.append(other)
        parsed = parse_room(self.room_text) if self.room_text else None
        report_discovery(self.discovery, self.account, self.config_dir, domains, parsed[0] if parsed else None)

    def server_info(self):
        """--server-info: connect to the gateway (the room's, when given) and report what it is and does."""
        report_server_info(self.discovery, self.account, self.config_dir, self._report_domain() or self.account.domain, USER_AGENT, self.verify_tls)


    def _own_configuration(self, configuration):
        if not configuration or not self.discovery.ws_server(self.account.domain):
            self.fail(f'{self.account.domain} publishes no SylkServer configuration with a wsServer')
            return
        parsed = parse_room(self.room_text)
        if parsed is None:
            self.fail(f'not a room: {self.room_text}')
            return
        room, host = parsed
        domain = configuration_domain(host) if host else self.account.domain
        if domain == self.account.domain:
            self._resolved(room, domain, configuration, remote=False)
        else:
            log.info(f'looking up the SylkServer of {domain}')
            self.discovery.discover(domain).addCallback(lambda other: self._resolved(room, domain, other, remote=True))

    def _resolved(self, room, domain, configuration, remote):
        if not configuration or not configuration.get('wsServer'):
            self.fail(f'{domain} runs no SylkServer (no configuration with a wsServer)')
            return
        self.target = RoomTarget(room, domain, configuration)
        self.remote = remote
        log.info(f'room {self.target.video_uri} at {self.target.ws_server}' + (' (another SylkServer)' if remote else ''))
        self.join()

    def fail(self, reason):
        log.error(reason)
        if reactor.running:
            reactor.stop()

    # The room

    def join(self):
        if self.stopping:
            return
        from sylkrtc.gst import MediaFactory
        self.session = VideoroomSession(self.identity, self.target.video_uri, self.target.ws_server,
                                        MediaFactory(audio_input=self.audio.chosen['input'], audio_output=self._audio_output(), stereo=self.stereo,
                                                     track_paths=self.track_paths, playback=self.arguments.playback or None,
                                                     monitor=self.arguments.monitor,
                                                     playback_gain=None if self.arguments.playback_level is None else MixerControl.level_gain(self.arguments.playback_level),
                                                     mic_gain=0.0 if self.arguments.device_level is None else MixerControl.level_gain(self.arguments.device_level),
                                                     jitter_buffer=self.arguments.jitter_buffer, playback_random=self.arguments.playback_random,
                                                     video_source=self.main_camera[1] if self.main_camera else None),
                                        ice_servers=self.target.ice_servers, guest_domain=self.target.guest_domain if self.remote else None,
                                        audio=not self.muted, video=self.main_camera is not None, receive_video=False, user_agent=USER_AGENT,
                                        verify_tls=self.verify_tls)
        self.session.listen_only = self.listen_only
        self.extras.clear()
        self.session.join()

    # Recording (--record-audio): the room's mix, as played, also (or only, --headless) into a file

    def _audio_output(self):
        """What the room's audio is played into: the chosen speakers (a recording is taken apart, see r)."""
        return self.audio.chosen['output']

    def _start_recording(self, media):
        """The whole mix (what we hear and what we send) into --record-audio's folder (else RECORDINGS), and with
        --record-tracks each participant's track and ours too."""
        room = self.target.sip_uri.replace('/', '_')
        stamp = time.strftime('%Y%m%d-%H%M%S')
        folder = os.path.join(os.path.expanduser(self.arguments.record_audio or RECORDINGS), room)
        os.makedirs(folder, mode=0o700, exist_ok=True)
        path = os.path.join(folder, stamp + '.ogg')
        tracks = os.path.join(os.path.expanduser(self.arguments.record_tracks), room, stamp + '-tracks') if self.arguments.record_tracks else None
        try:
            media.start_recording(path, tracks=tracks)
        except Exception as e:
            print(f'* cannot record: {e}')
            return
        self.recordings.append(path)
        print(f'* recording the room (what we hear and what we send) to {path}' + (f', each participant and us into {tracks}/' if tracks else '')
              + ' (r: stop)')

    def _finish_recording(self):
        """Leaving: the recording's files closed (Ogg's last page, FLAC's header written)."""
        media = getattr(self.session, 'media', None)
        if media is not None and getattr(media, 'recording', None):
            media.stop_recording(wait=1.0)

    def report_recordings(self):
        for path in self.recordings + self.track_paths:
            try:
                size = os.path.getsize(path)
            except OSError:
                print(f'* no recording made in {path}')
                continue
            print(f'* recorded: {path} ({size / 1024 / 1024:.1f} MB)' if size else f'* recorded nothing: {path} is empty')

    def _auto_leave(self):
        log.info(f'{self.arguments.auto_disconnect:g} s in the room: leaving (--auto-disconnect)')
        if reactor.running:
            reactor.stop()      # the shutdown trigger leaves the room

    def leave(self):
        self.stopping = True
        self.statistics.summary()
        self.statistics.stop()
        if self.recording and self.session is not None:
            self._finish_recording()
        if self.session is not None and self.session.state not in ('idle', 'terminated'):
            self.session.leave()
            return deferLater(reactor, 0.5, lambda: None)      # the leave requests go out
        return None


    def add_camera(self, label, source):
        if self.session is None or self.session.state != 'established' or self.stopping:
            return
        self.extras[label] = self.session.add_extra_video(dict(source), label)

    # Notifications

    def handle_notification(self, notification):
        handler = getattr(self, '_NH_%s' % notification.name, Null)
        handler(notification)

    def _NH_VideoroomSessionDidChangeState(self, notification):
        if notification.sender is not self.session:
            return
        state = notification.data.state
        if state == 'established':
            self.attempt = 0
            self._established = True
            self.established_at = reactor.seconds()
            if self.arguments.record_audio and self.session.media is not None and not self.session.media.recording:
                self._start_recording(self.session.media)        # --record-audio: from the start (r stops it)
            self.statistics.start(self.session)
            log.info(f'in the room {self.session.room}' + (f' as {self.session.address}' if self.session.guest else '') +
                     (' (microphone muted)' if self.session.audio_muted else '') +
                     (' (stereo room)' if self.session.stereo_room else ' (not a stereo room: its SIP participants are heard in mono)' if self.stereo else ''))
            for label, source in self.cameras:
                self.add_camera(label, source)
            if self.arguments.invite and not getattr(self, '_invited', False):
                self._invited = True        # once: not again after joining anew
                invitees = addresses(self.arguments.invite, self.account.domain)
                log.info(f'inviting {", ".join(invitees)}')
                self.session.invite(invitees)
            if self.arguments.auto_disconnect and not getattr(self, '_auto_disconnect', None):
                log.info(f'leaving in {self.arguments.auto_disconnect:g} s (--auto-disconnect)')
                self._auto_disconnect = reactor.callLater(self.arguments.auto_disconnect, self._auto_leave)
        elif state == 'terminated':
            self.statistics.ended()
            if self.listen_only and not self._established and not self.stopping:
                # the server did not take an offer that sends nothing: our audio as muted silence, as before
                self.listen_only = False
                log.info(f'the room did not take a listen-only join ({self.session.reason or "?"}): joining with muted silence')
                reactor.callLater(0, self.join)
                return
            if self.stopping or self.arguments.no_retry:
                if not self.stopping and reactor.running:
                    reactor.stop()
                return
            delay = RETRY_DELAYS[0 if self.arguments.auto_reconnect else min(self.attempt, len(RETRY_DELAYS) - 1)]
            self.attempt += 1
            log.info(f'joining again in {delay} s' + (' (--auto-reconnect)' if self.arguments.auto_reconnect else ''))
            reactor.callLater(delay, self.join)

    def _NH_VideoroomExtraVideoDidChangeState(self, notification):
        extra = notification.sender
        if extra.session is not self.session:
            return
        if notification.data.state == 'established':
            self.camera_retries[extra.label] = 0
        elif notification.data.state == 'ended' and not self.stopping and self.session.state == 'established' and notification.data.reason not in ('left', 'stopped'):
            attempts = self.camera_retries.get(extra.label, 0)
            self.camera_retries[extra.label] = attempts + 1
            delay = RETRY_DELAYS[min(attempts, len(RETRY_DELAYS) - 1)]
            log.info(f'{extra.label}: trying again in {delay} s')
            source = next(source for label, source in self.cameras if label == extra.label)
            if source.get('mac'):
                # its MAC address may answer at another IP address now (DHCP)
                from urllib.parse import urlsplit
                from sylkrtc.onvif import host_of_mac, with_host
                host, now = urlsplit(source['url']).hostname, host_of_mac(source['mac'])
                if now and now != host:
                    log.info(f'{extra.label}: its MAC address {source["mac"]} is at {now} now, not {host}')
                    source['url'] = with_host(source['url'], now)
            session = self.session
            reactor.callLater(delay, lambda: session is self.session and self.add_camera(extra.label, source))

    def _NH_VideoroomSessionParticipantDidJoin(self, notification):
        participant = notification.data.participant
        if notification.sender is self.session and participant.visible and not participant.parent:
            print(f'* {participant.name} joined')

    def _NH_VideoroomSessionParticipantDidLeave(self, notification):
        participant = notification.data.participant
        if notification.sender is self.session and participant.visible and not participant.parent:
            print(f'* {participant.name} left')

    def _NH_VideoroomSessionAudioMutedDidChange(self, notification):
        if notification.sender is self.session and notification.data.by:
            print(f'* microphone {"muted" if notification.data.muted else "unmuted"} by {notification.data.by}')

    def _NH_VideoroomSessionGotMessage(self, notification):
        if notification.sender is not self.session:
            return
        data = notification.data
        if data.sender_uri.lower() in (self.session.address.lower(), self.identity.address.lower()):
            return      # our own, back from the room
        who = data.sender_name or data.sender_uri or 'room'
        if data.content_type.startswith('text/'):
            print(f'{who}: {data.content}')
        else:
            print(f'{who}: [{data.content_type}, {len(data.content)} bytes]')

    def _NH_VideoroomSessionInviteStatus(self, notification):
        if notification.sender is self.session and notification.data.state in ('success', 'failed'):
            data = notification.data
            print(f'* invitation to {data.uri}: ' + ('accepted' if data.state == 'success' else f'failed ({data.code} {data.reason})'.replace(' )', ')')))

    def _NH_VideoroomSessionDidDeliverMessage(self, notification):
        if notification.sender is self.session and not notification.data.delivered:
            print(f'* message not delivered: {notification.data.code} {notification.data.reason}')

    def _audio_switched(self, kind):
        """A device plugged in (or the one used gone): used now, but not the speakers while recording."""
        if kind == 'output' and self.arguments.record_audio:
            self.audio.chosen['output'] = self.audio.configured['output']
            print('* new speakers not used: they cannot change while recording (--record-audio)')
            return
        media = self.session.media if self.session is not None and self.session.state not in ('idle', 'terminated') else None
        print('* ' + self.audio.apply(media, kind))

    def toggle_recording(self, media, name=None):
        """r (/record): the recording (--record-audio's: the whole mix, and with --record-tracks the tracks) stopped,
        or a new one started."""
        if media is None or not hasattr(media, 'start_recording'):
            print('* nothing to record yet')
            return
        if media.recording:
            print(f'* recording stopped: {media.stop_recording()}')
            return
        self._start_recording(media)

    def _toggle_channel(self, media, channel):
        """[ ]: the selected strip's left or right channel off in what we send (in stereo), or on again."""
        strip = self.mixer_control.selected_strip(media) if media is not None else None
        if strip is None or not hasattr(media, 'toggle_strip_channel'):
            print('* select a strip (← →) to turn its left ([) or right (]) channel off')
            return
        # ours: in what we send; one of what we hear: in what we hear of it
        on = media.toggle_strip_channel(strip['key'] if strip['kind'] == 'send' else 'listen:' + strip['key'], channel)
        if on is None:
            print('* we send mono: start with --stereo to set the channels apart')
        else:
            print(f'* {strip["name"]}: the {("left", "right")[channel]} channel ' + ('on' if on else 'off'))
        if self.panel is not None:
            self._update_panel()

    # The status panel: the top 65% of the terminal, the console scrolling under it

    PANEL_FRACTION = 0.65
    SIDEBAR_WIDTH = 44       # the list of the audio devices, on the left of the panel

    def start_panel(self):
        if self.arguments.discover or self.arguments.server_info:
            return      # a report: printed as it is
        self.panel = StatusPanel(fraction=self.PANEL_FRACTION, reserve=3 if self.arguments.no_logs else None)
        if not self.panel.start():
            self.panel = None
            return
        self.panel.on_resize = lambda: self.panel.update(self._panel_lines())
        if self.arguments.no_logs:
            log_file = getattr(self, 'log_file', None)
            print(f'* log lines: tail -f {log_file.path}' if log_file is not None else '* log lines: in ~/.sylkclient/logs/')
            mute_log_lines()        # the panel takes the terminal: the log lines to the file only
        from sylkrtc.util import RepeatingTimer
        self._panel_timer = RepeatingTimer(Statistics.TICK, self._update_panel)
        self._panel_timer.start(0)
        reactor.addSystemEventTrigger('after', 'shutdown', self.panel.stop)

    def _update_panel(self):
        try:
            self.panel.update(self._panel_lines())
        except Exception as e:
            log.debug(f'status panel: {e}')

    def _panel_lines(self):
        """Our microphone on the left, every participant on the right (a meter, or L and R for one that sends stereo),
        loss, round trip time and jitter between them; the traffic under them."""
        session = self.session
        audio = self.audio
        footer = DIM + '── /help · p live RTP log · /a /o microphone/speakers · /devices · /who · /quit ' + '─' * 400 + RESET
        out, incoming = None, []
        for row in self.statistics.current:
            if row['direction'] == 'out' and row['label'] in ('audio', 'audio+video'):
                out = row
            elif row['direction'] == 'in':
                incoming.append(row)
        channels = 2 if self.stereo else 1
        muted = session is not None and session.audio_muted
        title = f'{BOLD} {self.room_text}{RESET}  {session.state if session is not None else "starting"}'
        if session is not None and session.state == 'established' and getattr(self, 'established_at', None):
            seconds = int(reactor.seconds() - self.established_at)
            title += f' {seconds // 3600}:{seconds // 60 % 60:02d}:{seconds % 60:02d}' if seconds >= 3600 else f' {seconds // 60}:{seconds % 60:02d}'
        if session is not None:
            people = [participant for participant in session.participants.values() if participant.visible and not participant.parent]
            title += f'  {DIM}{len(people)} other{"s" if len(people) != 1 else ""}' + (', stereo room' if session.stereo_room else '') + RESET
        else:
            people = []
        if session is not None and getattr(session.media, 'recording', None):
            title += f'  {RED}{BOLD}● REC{RESET}'
        if muted:
            title += f'  {RED}{BOLD}MUTED{RESET}'

        def milliseconds(seconds):
            return None if seconds is None else 1000.0 * seconds
        loss_out = None if out is None or out.get('loss_held') is None else 100.0 * out['loss_held']        # the worst of 10 s
        losses = [100.0 * row['loss_held'] for row in incoming if row.get('loss_held') is not None]
        loss_in = max(losses) if losses else None
        rtt = milliseconds(out['rtt']) if out is not None else None
        jitter_out = milliseconds(out['jitter']) if out is not None else None
        jitters = [1000.0 * row['jitter'] for row in incoming if row['jitter'] is not None]
        jitter_in = max(jitters) if jitters else None
        # the network on the left (over the devices), the levels here
        # as wide as the column: its width less the name (9), a space and the value (up to 8), and its rule (2)
        lates = [100.0 * row['late_held'] for row in incoming if row.get('late_held') is not None]
        totals = dict(lost_out=out.get('lost_total') if out is not None else None,
                      lost_in=sum(row.get('lost_total') or 0 for row in incoming), late_in=sum(row.get('late_total') or 0 for row in incoming))
        connection = getattr(session, 'connection', None) if session is not None else None
        server_rtt = connection.rtt * 1000 if connection is not None and getattr(connection, 'rtt', None) is not None else None
        network = network_lines(rtt, loss_out, loss_in, jitter_out, jitter_in, jitter=self.arguments.jitter, width=self.SIDEBAR_WIDTH - 26,
                                late_in=max(lates) if lates else None, totals=totals, server_rtt=server_rtt,
                                rate_out=out['rate'] if out is not None else None,
                                rate_in=sum(row['rate'] for row in incoming if row['rate'] is not None) if any(row['rate'] is not None for row in incoming) else None)
        groups = [SCALE]
        # ours: the microphone (with --playback: the microphone, the music, then the total, all we send); then the participants
        media = session.media if session is not None and session.media is not None and session.state == 'established' else None
        mixer = getattr(media, 'send_mixer', None)
        control = self.mixer_control
        control.elsewhere = getattr(self, 'audio', None) is not None and self.audio.menu
        total = out['level'] if out is not None else None
        if mixer is not None:
            for strip in mixer.strips:
                if strip['name'] == 'total' and not self.arguments.total_out_level:
                    continue        # the total (what is sent) only with --total-out-level
                level = total if strip['name'] == 'total' else self.statistics.strip_levels.get(strip['name'])
                label, style = control.label(media, 'send', strip['name'], strip['name'], muted=strip['name'] == 'mic' and muted)
                groups.append((label, vu_meters(level, channels), style,
                               'PAUSED' if strip['name'] == 'music' and mixer.paused else media.channels_caption(strip['name'])))     # over its meters
        else:
            label, style = control.label(media, 'send', 'mic', 'mic', muted=muted)
            groups.append((label, vu_meters(total, channels), style, media.channels_caption('mic') if media is not None else None))
        groups.append(GAP)
        if self.console is not None:
            footer = DIM + '── ← → select · ↑ ↓ volume' + (' · u pause · n b next/back' if mixer is not None else '') + ' · 0-9 level · a/space hear it · v/o devices · m mute · Enter message · / command · ? help ' + '─' * 400 + RESET
        by_name = {row['label']: row for row in incoming}
        for participant in people:
            row = by_name.get(participant.name)
            level = row['level'] if row is not None else None
            label, style = control.label(media, 'listen', participant.name, participant.name.partition('@')[0][:12], muted=participant.muted)
            groups.append((label, vu_meters(level, 1), style,
                           media.channels_caption('listen:' + participant.name) if media is not None else None))
        sent = out['rate'] if out is not None and out['rate'] is not None else None
        received = sum(row['rate'] for row in incoming if row['rate'] is not None) if incoming else None
        info = [f' {BOLD}out{RESET} ' + (f'{human_rate(sent)} {human_bytes(out["bytes"])}' if sent is not None else '-')
                + f'    {BOLD}in{RESET} ' + (f'{human_rate(received)} {human_bytes(sum(row["bytes"] for row in incoming))} from {len(incoming)} feed{"s" if len(incoming) != 1 else ""}' if received is not None else '-'),
                f' {DIM}microphone{RESET} {audio.current("input")}    {DIM}speakers{RESET} {audio.current("output")}']
        if mixer is not None and MixerControl.info(mixer):
            info.append(MixerControl.info(mixer))
        if getattr(self, 'audio', None) is not None and self.panel.columns >= self.SIDEBAR_WIDTH + 60:
            lines = meter_panel(self.panel.height, self.panel.columns - self.SIDEBAR_WIDTH, title, groups, info, footer)
            return with_sidebar(lines, network + [''] + self.audio.sidebar(), self.SIDEBAR_WIDTH)
        return meter_panel(self.panel.height, self.panel.columns, title, groups, [network_text(rtt, loss_out, loss_in)] + info, footer)

    # The terminal

    # Single keys (--playback): the mixer's arrows; Enter or t a chat message, / a command

    KEYS_HELP = '''* keys (no Enter):
    ← →    select a strip of the mixer (in the panel): the microphone (with --playback the music too; the total with --total-out-level), each participant
    ↑ ↓    its volume (1 dB a press)
    0-9    the selected one's volume: 0 off, 1 to 9 from -40 dB (barely heard) to 0 dB (full), 5 dB a step
    a, space  hear the selected one of ours here too, or not: the amplifier (--monitor or --playback; headphones)
    u      pause the music, or play it on (as m for the microphone)
    [ ]    the selected one's left, right channel off in what we send, or on again (--stereo): talk on the left,
           music on the right
    n b    the next file of the music, the one before
    m      mute / unmute the microphone
    v o    the next microphone, the next speakers
    d      the device menu (in the panel): ↑ ↓ to a device, Enter to use it (both ways for one that is both), v as
           the microphone only, o as the speakers only; d or → closes it. ← from the mixer's
           first strip opens it too: the arrows go from the devices to the mixer and back
    p      log RTP statistics and audio levels every 2 s, or stop
    r      record the room (what we hear and what we send) into ~/.sylkclient/recordings/, or stop
    Enter  type a chat message (t too)
    /      type a command (/who, /invite, /devices, /input, /output, /quit, ...)
    ?      this'''

    def keys(self):
        """Back to single keys (after a typed line, and at the start): with the panel (the mixer), or --playback."""
        if self.console is not None and (self.arguments.playback or not self.arguments.no_panel):
            self.console.ask_key(self.key)

    def key(self, key):
        """One key typed: True when a line is typed next."""
        try:
            return self._key(key)
        except Exception:
            log.exception(f'the key {key!r}')        # else lost: Twisted's own log is not shown
            return False

    def _key(self, key):
        session = self.session
        mixer = getattr(session.media, 'send_mixer', None) if session is not None and session.media is not None else None
        audio = getattr(self, 'audio', None)
        if audio is not None and audio.menu:
            kinds = audio.menu_key(key)
            if kinds is not None:
                for kind in kinds:
                    self._audio_switched(kind)      # (not the speakers while recording)
                if self.panel is not None:
                    self._update_panel()
                return False
        if key == 'left' and audio is not None and self.panel is not None and self.mixer_control.at_first(session.media if session is not None else None):
            audio.open_menu()           # ← from the first strip of the mixer: the device menu, on its left
            self._update_panel()
            return False
        if key in MixerControl.KEYS:
            if self.mixer_control.key(session.media if session is not None else None, key) and self.panel is not None:
                self._update_panel()
            return False
        if key in ('\n', 't'):
            self.line_purpose = 'message'
            print('message: ', end='', flush=True)
            return True
        if key == '/':
            self.line_purpose = 'command'
            print('/', end='', flush=True)
            return True
        if key in ('a', ' ') and session is not None and session.media is not None:
            print('* ' + self.mixer_control.toggle_monitor(session.media))
            if self.panel is not None:
                self._update_panel()
        elif key in '[]' and session is not None and session.media is not None:
            self._toggle_channel(session.media, 0 if key == '[' else 1)
        elif key == 'u' and mixer is not None:
            print('* music paused' if mixer.toggle_pause() else '* music on')
        elif key in ('n', 'b') and mixer is not None:
            mixer.next() if key == 'n' else mixer.previous()
        elif key == 'd' and self.panel is not None:
            self.audio.open_menu()          # in the panel: ↑ ↓ to a device, Enter (or v, o) to use it
            self._update_panel()
        elif key == 'd':
            print('\n'.join(f'* {line}' for line in self.audio.lines()))
        elif key in ('v', 'o'):
            self._input(f'/{"input" if key == "v" else "output"}')      # as /input, /output: the next one
        elif key in '0123456789' and session is not None and session.media is not None:
            if self.mixer_control.set_level(session.media, int(key)) is not None and self.panel is not None:
                self._update_panel()
        elif key == 'm' and session is not None:
            session.set_audio_muted(not session.audio_muted)
            print('* microphone muted' if session.audio_muted else '* microphone on')
        elif key == 'p':
            print(f'* RTP statistics and audio levels every {self.statistics.LIVE_INTERVAL} s' if self.statistics.toggle_live() else '* RTP statistics off')
        elif key == 'r':
            self.toggle_recording(session.media if session is not None and session.state == 'established' else None,
                                  self.target.sip_uri if self.target is not None else 'room')
        elif key in ('?', 'h'):
            print(self.KEYS_HELP)
        return False

    def input(self, line):
        purpose, self.line_purpose = getattr(self, 'line_purpose', None), None
        if purpose == 'command':
            line = '/' + line if line else ''
        try:
            if purpose == 'message' and line.startswith('/'):
                line = ' ' + line       # a message as typed, not a command
            self._input(line)
        finally:
            self.keys()

    def _input(self, line):
        if not line:
            return
        if getattr(self, 'log_file', None) is not None:
            self.log_file.typed(line)
        session = self.session
        if line.lower() == '/record':
            self.toggle_recording(session.media if session is not None and session.state == 'established' else None,
                                  self.target.sip_uri if self.target is not None else 'room')
            return
        if line.lower() in ('p', '/p', '/rtp'):
            print(f'* RTP statistics and audio levels every {self.statistics.LIVE_INTERVAL} s' if self.statistics.toggle_live() else '* RTP statistics off')
            return
        if line.startswith('/'):
            command, _, rest = line[1:].partition(' ')
            command = command.lower()
            if command in ('quit', 'exit', 'q'):
                reactor.stop()
            elif command == 'mute' and session is not None:
                session.set_audio_muted(True)
            elif command == 'unmute' and session is not None:
                session.set_audio_muted(False)
            elif command in ('devices', 'd'):
                print('\n'.join(f'* {line}' for line in self.audio.lines()))
            elif command in ('input', 'output', 'a', 'o'):
                kind = 'input' if command in ('input', 'a') else 'output'
                if kind == 'output' and self.arguments.record_audio:
                    print('* the speakers cannot change while recording')
                    return
                try:
                    self.audio.select(kind, int(rest) if rest.strip() else None)
                except ValueError as e:
                    print(f'* {e}')
                    return
                print('* ' + self.audio.apply(session.media if session is not None and session.state not in ('idle', 'terminated') else None, kind))
            elif command == 'hand' and session is not None:
                session.toggle_hand()
            elif command == 'invite' and session is not None and rest.strip():
                session.invite(addresses(rest.split(), self.account.domain))
            elif command == 'who' and session is not None:
                people = [participant.name for participant in session.participants.values() if participant.visible and not participant.parent]
                print('* ' + (', '.join(sorted(people)) if people else 'nobody else'))
                if self.main_camera:
                    print(f'* our video: {self.main_camera[0]}')
                for extra in session.extra_videos.values():
                    media = extra.media
                    sent = f', {media.bytes_sent // 1024} KB sent' if media is not None else ''
                    how = (' (relayed)' if media.relay else ' (encoded)') if media is not None and extra.state == 'established' else ''
                    print(f'* our {extra.label}: {extra.state}{how}{sent}')
            else:
                print('* /mute, /unmute, /hand, /who, /invite user@domain ..., p (/rtp) RTP statistics and audio levels every 2 s on/off, /record the room on/off, /devices (/d), /input [N] (/a), /output [N] (/o) the next or Nth microphone/speakers, /quit; anything else goes to the chat')
            return
        if session is None or session.state != 'established':
            print('* not in the room')
            return
        session.send_message(line)


def main():
    arguments = parse_arguments()
    setup_logging(arguments)
    log_file = start_log_file('sylk-conference')
    client = SylkConference(arguments)
    client.log_file = log_file
    if not arguments.no_input and sys.stdin.isatty():
        client.console = Console(client)
        stdio.StandardIO(client.console)
        reactor.callWhenRunning(client.keys)        # --playback: single keys
    reactor.addSystemEventTrigger('before', 'shutdown', client.leave)     # SIGINT and SIGTERM stop the reactor
    client.panel = None
    if not arguments.no_panel:
        reactor.callWhenRunning(client.start_panel)
    reactor.callWhenRunning(client.start)
    reactor.run()
    client.report_recordings()


if __name__ == '__main__':
    main()
